# --- Base de données (service db) ---
POSTGRES_USER=piver
POSTGRES_PASSWORD=piver
POSTGRES_DB=piver

# --- Backend (service backend) ---
# Hostname interne `db` (réseau Docker), pas localhost.
DATABASE_URL=postgresql+psycopg2://piver:piver@db:5432/piver
# Origines autorisées par CORS (le front tourne sur l'hôte).
CORS_ORIGINS=http://localhost:3000

# --- Frontend (service frontend) ---
# URL que le navigateur utilise pour joindre l'API (port hôte mappé).
# Injectée dans le build Vite. Le CORS de l'API doit autoriser http://localhost:3000.
VITE_API_URL=http://localhost:8000
